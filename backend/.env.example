# Copy this file to .env and fill in GEMINI_API_KEY. Never commit .env.
GEMINI_API_KEY=

# Exact model IDs (verified against Google's model pages)
LIVE_MODEL=gemini-3.8-live
LIVE_MODEL_BACKUP=gemini-3.1-flash-live-preview
TEXT_MODEL=gemini-3.5-flash-lite

# Comma-separated browser origins allowed to call the backend
ALLOWED_ORIGINS=http://localhost:3000
